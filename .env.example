# Overrides opcionales para docker-compose.yml.
#
# Son opcionales: sin este archivo, `docker compose up --build` usa los valores
# por defecto indicados abajo. Copialo a `.env` si querés cambiarlos.

# Puerto publicado en el host. Define también PORT y BASE_URL del contenedor,
# así que los enlaces cortos apuntan a http://localhost:<API_PORT>.
API_PORT=10000

# Orígenes permitidos por CORS (lista separada por coma).
ALLOWED_ORIGINS=http://localhost:5173

# Secreto para firmar los JWT (mínimo 32 caracteres).
# Si no se define, el compose usa un valor SOLO para desarrollo local, público
# e inseguro. Para producción generá uno real y descomentá la línea:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=<tu-secreto-de-al-menos-32-caracteres>
