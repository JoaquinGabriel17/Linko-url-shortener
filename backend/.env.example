PORT=10000
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>
# JWT_SECRET: minimo 32 caracteres. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres>
JWT_EXPIRES_IN=1d
BASE_URL=http://localhost:10000
ALLOWED_ORIGINS=http://localhost:5173,https://url-shortener-xi-lac.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_REDIRECT_WINDOW_MS=60000
RATE_LIMIT_REDIRECT_MAX=120
